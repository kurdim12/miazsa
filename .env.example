# =============================================================================
# MIZAN — master environment template (Phase 2 vertical slice)
# Copy the relevant sections into web/.env and ee-worker/.env, or set as
# Supabase Edge Function secrets. NEVER commit real values. See docs/18-deployment.md.
# =============================================================================

# ---------- Frontend (web/, Vite — VITE_* are exposed to the browser) ----------
VITE_APP_ENV=local
VITE_APP_VERSION=0.1.0
VITE_SUPABASE_URL=                  # https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=            # anon (publishable) key — NOT the service role
VITE_MAPTILER_KEY=                 # restricted MapTiler key (URL/domain limited)
VITE_TILE_BASE_URL=                # optional: base URL for pre-exported EO tiles

# ---------- Supabase (server-side: migrations + Edge Functions) ----------
# In deployed Edge Functions, SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY
# are auto-injected. Set these locally for `supabase` CLI and the EE Worker.
SUPABASE_URL=                       # https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=         # SECRET — server-side only, full DB access
DATABASE_URL=                       # postgres://... (migrations)

# ---------- ee-compute Edge Function -> EE Worker ----------
EE_WORKER_URL=                      # https://<cloud-run-service>.run.app
EE_WORKER_AUTH_TOKEN=              # shared secret between Edge Function and EE Worker

# ---------- EE Worker (server-side Python) ----------
GEE_PROJECT_ID=                     # Google Earth Engine / GCP project id
GEE_SA_JSON=                        # path to, or inline JSON of, the GEE service account
# The worker writes results back to Supabase using:
#   SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY (above)

# ---------- AI (server-side, ai-insights — not in this slice but reserved) ----------
OPENAI_API_KEY=                     # SECRET — server-side only

# ---------- GCP (deployment — see docs/18-deployment.md) ----------
GCP_PROJECT_ID=
GCP_REGION=me-central1
