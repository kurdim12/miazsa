# =============================================================================
# MIZAN EE Worker — environment template (names only; never commit real values).
# Copy to ee-worker/.env for local runs. See the repo-root .env.example and
# docs/18-deployment.md. In Cloud Run these are injected from Secret Manager.
# =============================================================================

# ---------- Earth Engine / GCP ----------
GEE_PROJECT_ID=                 # Google Earth Engine / GCP project id
GEE_SA_JSON=                    # path to, OR inline JSON of, the GEE service-account key
EE_HIGH_VOLUME=true             # use the earthengine-highvolume endpoint (docs/05 §1.3)

# ---------- Supabase write target (service role; server-side only) ----------
SUPABASE_URL=                   # https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=      # SECRET — bypasses RLS; full DB access

# ---------- Inbound auth ----------
EE_WORKER_AUTH_TOKEN=           # shared bearer secret required on POST /compute

# ---------- Worker metadata (optional; sensible defaults baked in) ----------
EE_WORKER_VERSION=0.1.0         # stamped onto provenance.processing_version / computed_by
SPI_BASELINE_START_YEAR=1991    # CHIRPS SPI climatology baseline (docs/06 §6.2)
SPI_BASELINE_END_YEAR=2020
