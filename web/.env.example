# =============================================================================
# MIZAN web/.env.example  — Vite frontend environment (Phase-2 vertical slice)
# Copy to web/.env and fill in. Only VITE_* vars are exposed to the browser.
# NEVER put the service-role key or any server secret here. See docs/18.
# =============================================================================

# App metadata (shown in the footer / build banner).
VITE_APP_ENV=local
VITE_APP_VERSION=0.1.0

# Supabase project — PostgREST reads + Edge Functions + Auth.
VITE_SUPABASE_URL=                 # https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=            # anon (publishable) key — NOT the service role

# MapTiler — basemap style + tiles (URL/domain-restricted key).
VITE_MAPTILER_KEY=                 # restricted MapTiler key

# Optional: base URL for pre-exported EO tiles (COG / XYZ). Leave blank if unused.
VITE_TILE_BASE_URL=
